# Streamlit Secrets Configuration
# Rename this file to .streamlit/secrets.toml for local development
# For Streamlit Cloud, paste these contents into the "Secrets" settings area

# Firecrawl API Key (Required for Etsy/Web search)
FIRECRAWL_API_KEY = "fc-..."

# YouTube Data API Key (Required for YouTube search)
YOUTUBE_API_KEY = "AIza..."

# Instagram Graph API (Required for Instagram search)
INSTAGRAM_TOKEN = "IG..."
INSTAGRAM_USER_ID = "178..."

# Optional Database URL (defaults to local SQLite if not set)
# DATABASE_URL = "sqlite:///./niche.db"
